<?xml version="1.0"?>
<package format="3">
  <name>yanshee_teleop</name>
  <version>0.1.0</version>
  <description>Drive a UBTECH Yanshee with an Xbox controller: /cmd_vel -> walking gait, /joy buttons -> built-in motions.</description>
  <maintainer email="dasanplaen@gmail.com">dasanplaen</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
